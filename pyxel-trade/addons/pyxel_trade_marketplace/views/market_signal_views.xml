<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pyxel_market_signal_list" model="ir.ui.view">
        <field name="name">pyxel.market.signal.list</field>
        <field name="model">pyxel.market.signal</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="trend"/>
                <field name="variation"/>
                <field name="public_category_id"/>
            </list>
        </field>
    </record>

    <record id="view_pyxel_market_signal_form" model="ir.ui.view">
        <field name="name">pyxel.market.signal.form</field>
        <field name="model">pyxel.market.signal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="trend"/>
                            <field name="variation"/>
                        </group>
                        <group>
                            <field name="public_category_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Contexto">
                        <field name="note" nolabel="1"
                               placeholder="Qué explica esta señal y qué debe saber quien cotice."/>
                    </group>
                    <div class="text-muted">
                        Mientras no haya histórico de ventas, estas señales se
                        curan a mano. En cuanto lo haya, deben calcularse.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pyxel_market_signal" model="ir.actions.act_window">
        <field name="name">Cuba Market Pulse</field>
        <field name="res_model">pyxel.market.signal</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pyxel_market_signal" name="Cuba Market Pulse"
              parent="pyxel_trade_core.menu_pyxel_trade_root"
              action="action_pyxel_market_signal" sequence="10"/>

</odoo>
