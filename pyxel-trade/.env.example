# ─────────────────────────────────────────────────────────────
# PYXEL Cuba Trade OS — variables de despliegue
# Copiar a `.env` en el servidor y rellenar. NUNCA subir `.env` a git.
# ─────────────────────────────────────────────────────────────

# Dominio público. Debe apuntar por DNS (registro A) a la IP del servidor
# ANTES de levantar el stack: Caddy pide el certificado TLS al arrancar y
# falla si el dominio todavía no resuelve.
PYXEL_DOMAIN=trade.ejemplo.com

# Correo para los avisos de expiración de Let's Encrypt.
PYXEL_ACME_EMAIL=admin@ejemplo.com

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=postgres
POSTGRES_USER=odoo
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Odoo ────────────────────────────────────────────────────
# Contraseña maestra para crear/duplicar/borrar bases de datos.
# Generar con: openssl rand -base64 32
ODOO_ADMIN_PASSWD=

# Nombre de la base de datos de la plataforma.
ODOO_DB_NAME=pyxel_trade

# Número de workers. Regla práctica: (nº de vCPU * 2) + 1.
# CPX21 de Hetzner (3 vCPU) → 7. CPX31 (4 vCPU) → 9.
ODOO_WORKERS=7
