# ─────────────────────────────────────────────────────────────
# PYXEL Cuba Trade OS — entorno de producción
#
# Copiar a /opt/pyxel-trade/.env EN EL SERVIDOR, rellenar y proteger:
#   chmod 600 /opt/pyxel-trade/.env
# Este fichero (.env.example) no lleva ni un valor real. El .env sí, y por
# eso nunca se comitea.
# ─────────────────────────────────────────────────────────────

# Nombre del stack. Aísla contenedores, redes y volúmenes del resto de
# proyectos del GEX44. No lo cambies una vez desplegado: cambiarlo crea
# volúmenes nuevos y pierdes los datos de vista.
STACK=pyxel_trade

# ── Red ─────────────────────────────────────────────────────
# Subdominio de enetradex.com. Registro A en Cloudflare EN GRIS.
PYXEL_DOMAIN=trade.enetradex.com

# Puertos en 127.0.0.1. NUNCA en 0.0.0.0: el único que ve internet es el
# Caddy del host.
#
# Mapa del runbook (verificado 2026-08-28): 8250 seric, 8260 y 8261
# fábrica, 8300 ocupado. Estos dos se eligieron libres, pero
# VUELVE A COMPROBARLO el día del despliegue:  ss -ltnp | grep 831
PORT_WEB=8310
PORT_WEBSOCKET=8311

# ── PostgreSQL ──────────────────────────────────────────────
# Base propia del stack, en su propio volumen. No se comparte con nadie.
POSTGRES_USER=odoo
POSTGRES_DB=postgres
# openssl rand -base64 32
DB_PASSWORD=

# ── Odoo ────────────────────────────────────────────────────
# Etiqueta fija para que el despliegue sea reproducible: `odoo:19` se
# mueve y un `docker compose pull` podría cambiarte la versión sin
# avisar. Subirla es una decisión, no un efecto secundario.
ODOO_IMAGE=odoo:19.0-20260817

# openssl rand -base64 32
ODOO_ADMIN_PASSWD=
ODOO_DB=pyxel_trade

# Workers: (vCPU * 2) + 1, pero el GEX44 es compartido. Empieza contenido
# y sube sólo si hace falta.
ODOO_WORKERS=5

# ── Límites de recursos ─────────────────────────────────────
# El GEX44 es COMPARTIDO. Sin techo, un pico de Odoo (instalar módulos,
# regenerar assets) puede dejar sin memoria a Qbaprotic o a la fábrica.
# Estos límites son la garantía de que este proyecto no puede tumbar a
# los vecinos aunque se descontrole.
ODOO_MEM_LIMIT=3g
ODOO_CPUS=2
DB_MEM_LIMIT=1g
DB_CPUS=1

# Módulos que el despliegue automático actualiza en cada push.
ODOO_UPDATE_MODULES=pyxel_trade_core,pyxel_trade_marketplace
