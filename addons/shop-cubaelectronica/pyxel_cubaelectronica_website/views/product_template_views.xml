<odoo>
    <record id="view_product_template_form_inherit_banner" model="ir.ui.view">
        <field name="name">product.template.form.inherit.banner</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tag_ids']" position="after">
                <field name="show_in_banner"/>
                <field name="sale_type"/>
                <field name="wholesale_price"
                       invisible="sale_type == 'retail'"/>
                <field name="delivery_state_id"/>
                <field name="delivery_municipality_id"/>
            </xpath>
        </field>
    </record>
</odoo>