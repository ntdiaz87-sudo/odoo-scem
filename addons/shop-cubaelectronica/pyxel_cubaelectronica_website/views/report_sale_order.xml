<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- HEREDAMOS LA PLANTILLA PRINCIPAL DEL REPORTE DE PEDIDOS -->
    <template id="report_saleorder_document_custom" inherit_id="sale.report_saleorder_document">

        <!-- CAMBIO DE TÍTULO: "Presupuesto" -> "Pre-factura" -->
        <!-- <xpath expr="//h2[contains(@class, 'mt-4')]" position="replace">
            <h2 class="mt-4">
                <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice # </span>
                <span t-elif="doc.state in ['draft','sent']">Pre-factura # </span>
                <span t-else="">Pre-factura # </span>
                <span t-field="doc.name">SO0000</span>
            </h2>
        </xpath> -->

        <!-- 2. Cambiar “Dirección de facturación y entrega” por “Datos de Cliente” -->
        <xpath expr="//t[@t-set='information_block']/strong" position="replace">
            <strong>Datos de Cliente:</strong>
        </xpath>

            <!-- Quita todo el bloque del address -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <!-- vacío -->
        </xpath>

        <!-- Quita todo el bloque del information_block -->
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <!-- vacío -->
        </xpath>


        <xpath expr="//div[contains(@class, 'page')]" position="replace">
            <div class="page" style="margin-top:0; padding-top:0;">
                <!-- <div class="oe_structure"/> -->
                <h2 style="margin-top:0; padding-top:0;">
                    <span t-if="env.context.get('proforma', False) or is_pro_forma">Pre-Factura # </span>
                    <span t-elif="doc.state in ['draft','sent']">Pre-Factura # </span>
                    <span t-else="">Pre-Factura # </span>
                    <span t-field="doc.name">SO0000</span>
                </h2>

                <table class="table importes-table">
                        <tbody style="border:none">
                            <tr style="border:none">
                                <td style="border:none; width:50%">
                                    <div id="informations">
                                        <div t-if="doc.client_order_ref" class="col-auto col-3 mw-100 mb-2" name="informations_reference">
                                            <strong>Your Reference:</strong><br/>
                                            <span class="m-0" t-field="doc.client_order_ref">SO0000</span>
                                        </div>
                                

                                        <div>
                                            <strong>Cliente:</strong>
                                            <span t-field="doc.partner_id.name" style="white-space: nowrap;"/>
                                        </div>
                                        <t t-if="doc.partner_id.ci_number">
                                            <div>
                                                <strong>CI:</strong>
                                                <span t-field="doc.partner_id.ci_number" style="white-space: nowrap;"/>
                                            </div>
                                        </t>

                                        <div>
                                            <strong>Teléfono:</strong>
                                            <span t-field="doc.partner_id.phone" style="white-space: nowrap;"/>
                                        </div>

                                        <div>
                                            <strong>Dirección:</strong>
                                            <span t-esc="', '.join(filter(None, [
                                                doc.partner_id.street,
                                                doc.partner_id.street2,
                                                doc.partner_id.city,
                                                (doc.partner_id.state_id and doc.partner_id.state_id.name) or '',
                                                doc.partner_id.zip,
                                                (doc.partner_id.country_id and doc.partner_id.country_id.name) or ''
                                                ]))" style="white-space: nowrap;"/>
                                            
                                            <br/>
                                            <br/>
                                            <br/>
                                            <br/>

                                            <div style="display:flex; align-items:baseline; column-gap:6px; white-space:nowrap;">
                                                <strong>Sucursal:</strong>
                                                <span t-field="doc.company_id.name"/>
                                            </div>
                                            
                                            <div style="display:flex; align-items:baseline; column-gap:6px; white-space:nowrap;">
                                                <strong>Teléfono:</strong>
                                                <span t-field="doc.company_id.phone"/>
                                            </div>

                                            <div style="display:flex; align-items:baseline; column-gap:6px; white-space:nowrap;">
                                                <strong>Vendedor:</strong>
                                                <span t-field="doc.user_id"/>
                                            </div>

                                            <div t-if="doc.date_order" name="informations_date"
                                                style="display:flex; align-items:baseline; column-gap:6px; white-space:nowrap;">
                                                <strong>Fecha:</strong>
                                                <span class="m-0" t-field="doc.date_order" t-options='{"widget": "date"}'/>
                                            </div>
                                        </div>

                                    </div>
                                </td>
                                <td style="border:none; width:50%">
                                    <strong>Descripción: </strong>
                                    <br/>
                                    <span t-field="doc.description_report"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <br/>

                <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

                <div class="oe_structure"></div>
                <table class="table table-sm o_main_table table-borderless mt-4">
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_code" class="text-start">Código</th>
                            <th name="th_description" class="text-start">Artículo o Servicio</th>
                            <th name="th_quantity" class="text-end">Cantidad</th>
                            <th name="th_priceunit" class="text-end">Precio Unitario</th>
                            <th name="th_discount" t-if="display_discount" class="text-end">
                                <span>Desc.%</span>
                            </th>
                            <th name="th_taxes" class="text-end">Impuestos</th>
                            <th name="th_subtotal" class="text-end">
                                <span>Importe</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal" t-value="0"/>

                        <t t-foreach="lines_to_report" t-as="line">

                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td name="th_code"><span t-if="line.product_id" t-field="line.product_id.nom_code"/></td>
                                    <td name="td_name"><span t-field="line.name">Bacon Burger</span></td>
                                    <td name="td_quantity" class="text-end">
                                        <span t-field="line.product_uom_qty">3</span>
                                        <span t-field="line.product_uom">units</span>
                                        <span t-if="line.product_packaging_id">
                                            (<span t-field="line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="line.product_packaging_id"/>)
                                        </span>
                                    </td>
                                    <td name="td_priceunit" class="text-end">
                                        <span t-field="line.price_unit">3</span>
                                    </td>
                                    <td t-if="display_discount" class="text-end">
                                        <span t-field="line.discount">-</span>
                                    </td>
                                    <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                    <td name="td_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                        <span t-out="taxes">Tax 15%</span>
                                    </td>
                                    <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                        <span t-field="line.price_subtotal">27.00</span>
                                    </td>
                                </t>
                                <t t-elif="line.display_type == 'line_section'">
                                    <td name="td_section_line" colspan="99">
                                        <span t-field="line.name">A section title</span>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <td name="td_note_line" colspan="99">
                                        <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                    </td>
                                </t>
                            </tr>

                            <t t-if="current_section and (line_last or lines_to_report[line_index+1].display_type == 'line_section') and not line.is_downpayment">
                                <tr class="is-subtotal text-end">
                                    <td name="td_section_subtotal" colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                            t-out="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                                        >31.05</span>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row" name="total">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                            <table class="table table-sm table-borderless">
                                <!-- Tax totals -->
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-call="sale.document_tax_totals"/>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="oe_structure"></div>

           
                <br/>
                <br/>
                <div  t-if="doc.observations">
                    <strong>Observaciones</strong>
                    <br/>
                    <span t-field="doc.observations"/>
                </div>

                <table class="table importes-table">
                    <thead>
                        <tr style="border:none">
                            <th style="width:60%; border:none">Observaciones</th>
                            <th style="width:20%; border:none"></th>
                            <th style="width:20%; border:none"><t t-esc="doc.company_id.currency_id.name or ''"/></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="border:none">
                            <td style="width:60%; border:none">
                                <span t-field="doc.observations"/>
                            </td>
                            <td style="width:20%; border:none">
                                <p>Importe:</p>
                                <br/>
                                <p>Descuento:</p>
                                <br/>
                                <p>Recargo:</p>
                                <br/>
                                <p>Total:</p>
                                <br/>
                            </td>
                            <td style="width:20%; border:none">
                            </td>
                        </tr>
                    </tbody>
                </table>
                    <table class="table importes-table">
                        <tbody style="border:none">
                            <tr style="border:none">
                                <td style="border:none; width:50%">
                                    <p>Nombre:</p>
                                    <p>CI:</p>
                                    <p>Cargo:</p>
                                    <p>Firma:</p>
                                    <br/>
                                </td>
                                <td style="border:none; width:50%">
                                    <p>Elaborado por: </p>
                                    <br/>
                                    <p>Firma:</p>

                                </td>
                            </tr>
                        </tbody>
                    </table>

                <!-- <div style="border-top:2px solid black">
                    <br/>
                    <br/>
                    <span>Dirija sus pagos a:</span>
                    <br/>
                    <span> Cuenta en CUP: 
                        <t t-esc="doc.company_id.cup_account_number or ''"/>,
                        <t t-esc="doc.company_id.cup_bank or ''"/>
                    </span>
                    <br/>
                    <span> Cuenta en moneda extranjera: 
                        <t t-esc="doc.company_id.usd_account_number or ''"/>,
                        <t t-esc="doc.company_id.usd_bank or ''"/>
                    </span>
                </div> -->


                <div class="oe_structure"/>
            </div>
        </xpath>



    </template>

</odoo>
