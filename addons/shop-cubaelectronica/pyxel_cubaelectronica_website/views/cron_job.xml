<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_backfill_seq_code_id_client_once" model="ir.cron">
        <field name="name">Llenar "ID Cliente" de los contactos ya existentes (una vez)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">env['res.partner'].search([('seq_code_id_client','=',False)])._assign_seq_code_id_client_if_needed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">1</field>
        <field name="active">True</field>
    </record>
</odoo>
