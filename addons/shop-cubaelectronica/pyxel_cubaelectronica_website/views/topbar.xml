<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Buscador en la cabecera, renderizado por plantilla (sin JS → sin flash).
         Se inserta después del botón de dirección (delivery). priority alta
         para que el delivery ya exista cuando se aplica este xpath. -->
    <template id="cevende_header_search" inherit_id="website.option_header_brand_logo"
              name="CEVENDE Buscador Cabecera" priority="90">
        <xpath expr="//div[contains(@class, 'delivery_modal_div') and contains(@class, 'desktop_delivery_button')]"
               position="after">
            <form class="cv-header-search" action="/shop" method="get">
                <input type="text" name="search" autocomplete="off"
                       placeholder="Buscar productos..."/>
                <button type="submit" aria-label="Buscar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </button>
            </form>
        </xpath>
    </template>

    <!-- Trust bar site-wide: se inyecta encima del header en todas las páginas -->
    <template id="cevende_topbar" inherit_id="website.layout" name="CEVENDE Trust Bar">
        <xpath expr="//header" position="before">
            <div class="cv-topbar">
                <div class="cv-container">
                    <div class="cv-topbar__left">
                        <span><i class="cv-dot"/> Envíos a toda Cuba</span>
                        <span><i class="cv-dot"/> Garantía oficial</span>
                        <span><i class="cv-dot"/> Pagos seguros</span>
                        <span><i class="cv-dot"/> Soporte 24/7</span>
                    </div>
                    <div class="cv-topbar__right">
                        <!-- Selector segmentado de modo (siempre visible). Identifica
                             y cambia entre catálogo Minorista / Mayorista. El activo se
                             resalta en color (azul minorista / turquesa mayorista). -->
                        <t t-set="cv_mode" t-value="request.session.get('cv_sale_mode') or 'retail'"/>
                        <div class="cv-modeswitch" role="group" aria-label="Modo de compra">
                            <span class="cv-modeswitch__label">Comprando:</span>
                            <a href="/shop?tipo=retail"
                               t-attf-class="cv-modeswitch__opt cv-modeswitch__opt--retail #{'is-active' if cv_mode == 'retail' else ''}"
                               t-att-aria-current="'true' if cv_mode == 'retail' else None">
                                <i class="fa fa-shopping-bag"/> Minorista
                            </a>
                            <a href="/shop?tipo=wholesale"
                               t-attf-class="cv-modeswitch__opt cv-modeswitch__opt--wholesale #{'is-active' if cv_mode == 'wholesale' else ''}"
                               t-att-aria-current="'true' if cv_mode == 'wholesale' else None">
                                <i class="fa fa-cubes"/> Mayorista
                            </a>
                        </div>
                        <span>Ayuda</span>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Barra de navegación principal (diseño CEVENDE), debajo del header -->
        <xpath expr="//header" position="after">
            <nav class="cv-mainnav d-none d-lg-block">
                <div class="cv-container">
                    <ul class="cv-mainnav__list">
                        <t t-foreach="website.menu_id.child_id" t-as="item" t-key="item.id">
                            <li t-if="item.name != 'Contacto'">
                                <a t-att-href="item.url" t-att-class="'cv-mainnav__link' + (' is-active' if item.url == request.httprequest.path else '')">
                                    <span t-esc="item.name"/>
                                    <span t-if="item.name == 'Energía Solar'" class="cv-nav-badge cv-nav-badge--new">Nuevo</span>
                                    <span t-if="item.name == 'Ofertas'" class="cv-nav-badge cv-nav-badge--hot">Hot</span>
                                </a>
                            </li>
                        </t>
                    </ul>
                </div>
            </nav>
        </xpath>

        <!-- Drawer lateral del carrito (Fase 2) -->
        <xpath expr="//header" position="after">
            <div class="cv-cart-overlay" id="cvCartOverlay"/>
            <aside class="cv-cart-drawer" id="cvCartDrawer" aria-hidden="true">
                <div class="cv-cart-drawer__head">
                    <h3>Mi carrito <span class="cv-cart-drawer__count" id="cvCartCount">0</span></h3>
                    <button type="button" class="cv-cart-drawer__close" id="cvCartClose" aria-label="Cerrar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="20" height="20"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
                <div class="cv-cart-drawer__body" id="cvCartBody">
                    <!-- Las líneas se renderizan por JS -->
                </div>
                <div class="cv-cart-drawer__foot" id="cvCartFoot">
                    <div class="cv-cart-drawer__total">
                        <span>Subtotal</span>
                        <strong id="cvCartTotal">$0.00</strong>
                    </div>
                    <!-- El panel lateral lleva a la PÁGINA del carrito (/shop/cart,
                         pública). El botón "Finalizar compra" / "Comprar (mayorista)"
                         está dentro de esa página; el login (y la acreditación en
                         mayorista) salta al pulsarlo, no en el carrito. -->
                    <a href="/shop/cart" class="cv-cart-drawer__checkout" id="cvCartCheckout">
                        Ver carrito
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                    <button type="button" class="cv-cart-drawer__continue" id="cvCartContinue">Seguir comprando</button>
                </div>
            </aside>
        </xpath>
    </template>

    <!-- Quitar el modal de selección de zona: la zona ahora la lleva cada
         producto (delivery_state_id / delivery_municipality_id). La plantilla
         'pyxel_cem_delivery_methods.layout' SOLO inyecta los dos modales de zona
         en el <body>; al desactivarla, los modales no se renderizan (ni su JS de
         auto-apertura) y no hay 500. El botón de zona de la cabecera se conserva
         (es el ancla del buscador) y se oculta por CSS. -->
    <record id="pyxel_cem_delivery_methods.layout" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

</odoo>
