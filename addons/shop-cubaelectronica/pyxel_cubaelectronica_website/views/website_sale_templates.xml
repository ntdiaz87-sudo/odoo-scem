<odoo>
    <template id="shop_mark_filter_sidebar" inherit_id="website_sale.products"
              name="Filtro marcas tienda visual integrado">
        <xpath expr="//div[contains(@class, 'o_wsale_products_grid_before_rail')]" position="before">
            <t t-if="use_brand_filter">
                <div class="tp-marks-filter extra-filters mt-3">
                    <b>Marcas</b>
                    <ul class="nav nav-pills flex-column">
                        <li class="nav-item">
                            <div t-att-data-link-href="keep('/shop', brand=0, category=current_category, provider=current_provider)"
                                 class="custom-control form-check mb-1 d-inline-block">
                                <input type="radio" class="form-check-input o_not_editable"
                                       id="all_marks" name="brand" value="all"
                                       t-att-checked="'checked' if not current_brand else None"/>
                                <label class="form-check-label fw-normal" for="all_marks">
                                    Todas las Marcas
                                </label>
                            </div>
                        </li>

                        <t t-foreach="marks" t-as="mark">
                            <li class="nav-item">
                                <div t-att-data-link-href="keep('/shop', brand=mark['id'], category=current_category, provider=current_provider)"
                                     class="custom-control form-check mb-1 d-inline-block">
                                    <input type="radio" class="form-check-input o_not_editable"
                                           t-att-id="'mark_' + str(mark['id'])"
                                           name="brand"
                                           t-att-value="mark['id']"
                                           t-att-checked="'checked' if current_brand == mark['id'] else None"/>
                                    <label class="form-check-label fw-normal" t-att-for="'mark_' + str(mark['id'])">
                                        <span t-esc="mark['name']"/>
                                        <span t-if="mark['product_count']">
                                            (<t t-esc="mark['product_count']"/>)
                                        </span>
                                    </label>
                                </div>
                            </li>
                        </t>
                    </ul>
                </div>
            </t>
        </xpath>
    </template>

    <template id="add_brand_filter_responsive"
              inherit_id="pyxel_cem_website_sale.scem_filter_products_responsive"
              name="Add Brand Filter to Responsive Sidebar">

        <!-- Agregar el filtro de marcas después del filtro de proveedores -->
        <xpath expr="//div[contains(@class, 'extra-filters-responsive')]/div[contains(@class, 'tp-providers-filter')]"
               position="after">

            <div class="line" t-if="use_brand_filter"/>

            <div class="tp-marks-filter mt-3" t-if="use_brand_filter">
                <b>Marcas</b>
                <ul class="nav nav-pills flex-column">
                    <li class="nav-item">
                        <div t-att-data-link-href="keep('/shop', brand=0, category=current_category, provider=current_provider)"
                             class="custom-control form-check mb-1 d-inline-block">
                            <input type="radio" class="form-check-input o_not_editable"
                                   id="all_marks_responsive" name="brand_responsive" value="all"
                                   t-att-checked="'checked' if not current_brand else None"/>
                            <label class="form-check-label fw-normal" for="all_marks_responsive">
                                Todas las Marcas
                            </label>
                        </div>
                    </li>

                    <t t-foreach="marks" t-as="mark">
                        <li class="nav-item">
                            <div t-att-data-link-href="keep('/shop', brand=mark['id'], category=current_category, provider=current_provider)"
                                 class="custom-control form-check mb-1 d-inline-block">
                                <input type="radio" class="form-check-input o_not_editable"
                                       t-att-id="'mark_' + str(mark['id']) + '_responsive'"
                                       name="brand_responsive"
                                       t-att-value="mark['id']"
                                       t-att-checked="'checked' if current_brand == mark['id'] else None"/>
                                <label class="form-check-label fw-normal"
                                       t-att-for="'mark_' + str(mark['id']) + '_responsive'">
                                    <span t-esc="mark['name']"/>
                                    <span t-if="mark['product_count']">
                                        (<t t-esc="mark['product_count']"/>)
                                    </span>
                                </label>
                            </div>
                        </li>
                    </t>
                </ul>
            </div>
        </xpath>
    </template>

    <template id="fix_category_filter_with_brand" inherit_id="pyxel_cem_website_sale.scem_filter_products"
              name="Fix Category Filter to Preserve Brand">

        <!-- Modificar el enlace de "Todas las Categorías" -->
        <xpath expr="//div[contains(@class, 'tp-categories-filter')]//div[contains(@class, 'custom-control')][./input[@id='all_categories']]"
               position="attributes">
            <attribute name="t-att-data-link-href">keep('/shop', category=0, provider=current_provider,
                brand=current_brand)
            </attribute>
        </xpath>

        <!-- Modificar los enlaces de categorías padres -->
        <xpath expr="//div[contains(@class, 'tp-categories-filter')]//li[contains(@class, 'parent-category')]//a[contains(@class, 'custom-control')]"
               position="attributes">
            <attribute name="t-att-data-link-href">keep('/shop', category=parent_cat.get('id'),
                provider=current_provider, brand=current_brand)
            </attribute>
        </xpath>

        <!-- Modificar los enlaces de categorías hijas -->
        <xpath expr="//div[contains(@class, 'tp-categories-filter')]//li[contains(@class, 'child-category')]//div[contains(@class, 'custom-control')]"
               position="attributes">
            <attribute name="t-att-data-link-href">keep('/shop', category=child_cat.get('id'),
                provider=current_provider, brand=current_brand)
            </attribute>
        </xpath>

    </template>

    <!-- También corregir el filtro responsive si es necesario -->
    <template id="fix_category_filter_responsive_with_brand"
              inherit_id="pyxel_cem_website_sale.scem_filter_products_responsive"
              name="Fix Responsive Category Filter to Preserve Brand">

        <!-- Modificar enlace de "Todas las Categorías" en responsive -->
        <xpath expr="//div[contains(@class, 'extra-filters-responsive')]//div[contains(@class, 'tp-categories-filter')]//div[contains(@class, 'custom-control')][./input[@id='all_categories_responsive']]"
               position="attributes">
            <attribute name="t-att-data-link-href">keep('/shop', category=0, provider=current_provider,
                brand=current_brand)
            </attribute>
        </xpath>

        <!-- Modificar enlaces de categorías padres en responsive -->
        <xpath expr="//div[contains(@class, 'extra-filters-responsive')]//li[contains(@class, 'parent-category')]//a[contains(@class, 'custom-control')]"
               position="attributes">
            <attribute name="t-att-data-link-href">keep('/shop', category=parent_cat.get('id'),
                provider=current_provider, brand=current_brand)
            </attribute>
        </xpath>

        <!-- Modificar enlaces de categorías hijas en responsive -->
        <xpath expr="//div[contains(@class, 'extra-filters-responsive')]//li[contains(@class, 'child-category')]//div[contains(@class, 'custom-control')]"
               position="attributes">
            <attribute name="t-att-data-link-href">keep('/shop', category=child_cat.get('id'),
                provider=current_provider, brand=current_brand)
            </attribute>
        </xpath>

    </template>

