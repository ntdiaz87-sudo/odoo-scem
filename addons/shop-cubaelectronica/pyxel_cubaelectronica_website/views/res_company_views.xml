<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_hide_bank" model="ir.ui.view">
        <field name="name">res.company.form.inherit.hide.bank</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="pyxel_cem_sale.view_company_form_inherit"/> 
        <field name="arch" type="xml">
            <xpath expr="//page[contains(@name, 'pay_det')]/group" position="inside">
                <field name="cup_account_number"/>
                <field name="cup_bank"/>
                <field name="usd_account_number"/>
                <field name="usd_bank"/>
            </xpath>


        </field>
    </record>

</odoo>
