<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================
             pyxel_cubaelectronica_website · report_invoice.xml
             ================================================================
             CORRECCIONES APLICADAS vs versión anterior:

             1. external_layout_standard_inherit_cubaelectronic:
                Sigue heredando de pyxel_cem_sale.external_layout_standard_inherit
                (correcto, ya era así).

             2. report_invoice_document_cubaelect_inherit:
                *** CORRECCIÓN CRÍTICA ***
                ANTES:  inherit_id="account.report_invoice_document"  ← SALTABA AL ABUELO
                AHORA:  inherit_id="pyxel_cem_sale.report_invoice_document_cem_inherit"

             3. invoice_informations_block_cubaelect:
                Sobreescribe SOLO el sub-template de informaciones del padre,
                con la versión que muestra la tabla Referencia/NIT/Factura
                más grid de cliente con teléfono.

             4. invoice_payment_details_block_cubaelect:
                Vacía el bloque de pago (cubaelectronica no lo usa).

             5. invoice_sign_table_block_cubaelect:
                Vacía la tabla de firmas del padre (cubaelectronica tiene
                su propia tabla Facturador/Transportador/Cliente dentro
                del xpath post-totales).

             REGLA: ningún hijo toca al abuelo (account.report_invoice_document).
             ================================================================ -->


        <template id="external_layout_standard_inherit_cubaelectronic"
                  inherit_id="pyxel_cem_sale.external_layout_standard_inherit">
            <xpath expr="//div[contains(@class, 'row')]" position="replace">
                <div class="row text-center align-items-center">
                    <div class="col-4">
                        <img t-if="company and company.logo"
                             t-att-src="image_data_uri(company.logo)"
                             style="max-height: 60px; margin: auto;" alt="Logo"/>
                    </div>
                    <!-- NIT/REEUP/Factura/Fecha van en invoice_informations_block,
                         no en el header, para cubaelectronica -->
                </div>
            </xpath>
        </template>


        <template id="report_invoice_document_cubaelect_inherit"
                  inherit_id="pyxel_cem_sale.report_invoice_document_cem_inherit">

            <!-- H2 en español con todos los estados posibles -->
            <xpath expr="//div[@class='page mb-4']/h2" position="replace">
                <h2 style="text-align: center; margin-bottom: 100px;">
                    <t t-if="not proforma"/>
                    <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Factura</t>
                    <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Pre Factura</t>
                    <t t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura Cancelada</t>
                    <t t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Nota de Crédito</t>
                    <t t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Borrador de Nota de Crédito</t>
                    <t t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Nota de Crédito Cancelada</t>
                    <t t-elif="o.move_type == 'in_refund'">Nota de Crédito de Proveedor</t>
                    <t t-elif="o.move_type == 'in_invoice'">Factura de Proveedor</t>
                </h2>
            </xpath>

            <!-- Tabla pre-factura (No., Fecha, Vendedor, Contrato) antes de líneas -->
            <xpath expr="//table[@name='invoice_line_table']" position="before">
                <h5>Prefactura</h5>
                <table class="table prefactura-table" style="border:none">
                    <thead style="border:none">
                        <tr style="border:none">
                            <th style="border:none; text-align:left;">No.</th>
                            <th style="border:none; text-align:left;">Fecha</th>
                            <th style="border:none; text-align:left;">Vendedor</th>
                            <th style="border:none; text-align:left;">Contrato</th>
                        </tr>
                    </thead>
                    <tbody style="border:none">
                        <tr style="border:none">
                            <td style="border:none">
                                <span t-esc="o.sale_order_name"/>
                            </td>
                            <td style="border:none">
                                <span t-field="o.sale_order_date"
                                      t-options='{"widget": "date"}'/>
                            </td>
                            <td style="border:none">
                                <t t-esc="o.invoice_user_id.name"/>
                            </td>
                            <td style="border:none"/>
                        </tr>
                    </tbody>
                </table>
                <br/>
                <br/>
                <br/>
            </xpath>

            <!-- Tabla de líneas completa: Código, Artículo, Cantidad,
                 Precio Unitario, Desc.%, Impuestos, Importe -->
            <xpath expr="//table[@name='invoice_line_table']" position="replace">
                <table class="table table-sm o_main_table table-borderless"
                       name="invoice_line_table">
                    <thead>
                        <tr>
                            <th name="th_code" class="text-start">Código</th>
                            <th name="th_description" class="text-start">
                                <span>Artículo o Servicio</span>
                            </th>
                            <th name="th_quantity" class="text-end">
                                <span>Cantidad</span>
                            </th>
                            <th name="th_priceunit"
                                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Precio Unitario</span>
                            </th>
                            <th name="th_discount" t-if="display_discount"
                                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Desc.%</span>
                            </th>
                            <th name="th_taxes"
                                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Impuestos</span>
                            </th>
                            <th name="th_subtotal" class="text-end">
                                <span>Importe</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="current_total" t-value="0"/>
                        <t t-set="lines"
                           t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                        <t t-foreach="lines" t-as="line">
                            <t t-set="current_subtotal"
                               t-value="current_subtotal + line.price_subtotal"/>
                            <t t-set="current_total"
                               t-value="current_total + line.price_total"/>

                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type == 'product'"
                                   name="account_invoice_line_accountable">
                                    <td name="th_code">
                                        <span t-if="line.product_id"
                                              t-field="line.product_id.nom_code"/>
                                    </td>
                                    <td name="account_invoice_line_name">
                                        <span t-if="line.name"
                                              t-field="line.name"
                                              t-options="{'widget': 'text'}"/>
                                    </td>
                                    <td name="td_quantity" class="text-end">
                                        <span t-field="line.quantity"/>
                                        <!-- UoM omitida intencionalmente -->
                                    </td>
                                    <td name="td_price_unit"
                                        t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span class="text-nowrap"
                                              t-field="line.price_unit"/>
                                    </td>
                                    <td name="td_discount" t-if="display_discount"
                                        t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span class="text-nowrap"
                                              t-field="line.discount"/>
                                    </td>
                                    <t t-set="taxes"
                                       t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                    <td name="td_taxes"
                                        t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                        <span t-out="taxes" id="line_tax_ids"/>
                                    </td>
                                    <td name="td_subtotal" class="text-end o_price_total">
                                        <span class="text-nowrap"
                                              t-field="line.price_subtotal"/>
                                    </td>
                                </t>
                                <t t-elif="line.display_type == 'line_section'">
                                    <td colspan="99">
                                        <span t-if="line.name"
                                              t-field="line.name"
                                              t-options="{'widget': 'text'}"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <td colspan="99">
                                        <span t-if="line.name"
                                              t-field="line.name"
                                              t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>
                            </tr>

                            <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span t-out="current_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </xpath>

            <!-- Bloque post-totales: observaciones, condiciones y tabla de firmas
                 Facturador / Transportador / Cliente -->
            <xpath expr="//div[@id='right-elements']" position="after">

                <br/>
                <br/>
                <br/>
                <br/>
                <br/>
                <br/>
                <br/>
                <br/>

                <!-- Observaciones -->
                <span>Observaciones:</span>
                <span t-field="o.observations"/>
                <br/>

                <!-- Términos de pago -->
                <span>Términos de pago:</span>
                <span>
                    <t t-if="o.invoice_payment_term_id"
                       t-esc="o.invoice_payment_term_id.name"/>
                </span>
                <br/>

                <!-- Forma de pago -->
                <span>Forma de pago:</span>
                <span>
                    <t t-if="o.selected_payment_method_payment_id"
                       t-esc="o.selected_payment_method_payment_id.name"/>
                </span>
                <br/>

                <!-- Fecha de vencimiento -->
                <span>Fecha de vencimiento:</span>
                <span>
                    <t t-if="o and o.invoice_date_due"
                       t-esc="o.invoice_date_due"/>
                </span>
                <br/>
                <br/>

                <!-- NUEVA TABLA DE FIRMAS (limpia y corregida) -->
                <div class="signature-block">
                    <table class="table contact-info-table no-break">
                        <thead>
                            <tr>
                                <th>Despachado por</th>
                                <th>Transportador</th>
                                <th>Recibido por</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>
                                    <p>Nombre:</p>
                                    <p>Firma:</p>
                                    <br/>
                                    <br/>
                                </td>

                                <td>
                                    <p>Nombre:</p>
                                    <br/>
                                    <br/>
                                </td>

                                <td>
                                    <p>Nombre:</p>
                                    <p>Firma:</p>
                                    <br/>
                                    <br/>
                                </td>
                            </tr>

                            <tr style="border-bottom:none; height:13px; padding:0;">
                                <td style="text-align:center; height:13px; border-bottom:none; padding:0;">
                                    <span style="margin:0; line-height:13px;">D / M / A</span>
                                </td>
                                <td style="text-align:center; height:13px; border-bottom:none; padding:0;">
                                </td>
                                <td style="text-align:center; height:13px; border-bottom:none; padding:0;">
                                    <span style="margin:0; line-height:13px;">D / M / A</span>
                                </td>
                            </tr>

                            <tr style="border-top:none;">
                                <td style="border-top:none;">
                                    <span>Fecha</span>
                                </td>
                                <td style="border-top:none;">

                                </td>
                                <td style="border-top:none;">
                                    <span>Fecha</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <style>
                    .signature-block,
                    .signature-block table,
                    .signature-block tbody,
                    .signature-block tr,
                    .signature-block td,
                    .signature-block th {
                    page-break-inside: avoid !important;
                    break-inside: avoid-page !important;
                    }
                </style>

            </xpath>


            <!-- Elimina la sección de Taxes USD (company currency) -->
            <xpath expr="//t[@t-call='account.document_tax_totals_company_currency_template']"
                   position="replace"/>

            <!-- Tabla de totales con traducciones en español -->
            <xpath expr="//div[@id='total']//table[contains(@class, 'table-borderless')]"
                   position="replace">
                <table class="table table-sm table-borderless avoid-page-break-inside">
                    <!-- Tax totals -->
                    <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                    <t t-call="account.document_tax_totals"/>

                    <!-- Pagos aplicados con traducción "Pagado el" -->
                    <t t-if="print_with_payments">
                        <t t-if="o.payment_state != 'invoicing_legacy'">
                            <t t-set="payments_vals"
                               t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                            <t t-foreach="payments_vals" t-as="payment_vals">
                                <tr t-if="payment_vals['is_exchange'] == 0">
                                    <td>
                                        <i class="oe_form_field text-end oe_payment_label">
                                            Pagado el
                                            <t t-out="payment_vals['date']"
                                               t-options='{"widget": "date"}'/>
                                        </i>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="payment_vals['amount']"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="len(payments_vals) > 0">
                                <tr class="border-black fw-bold">
                                    <td>Saldo Pendiente</td>
                                    <td class="text-end">
                                        <span t-field="o.amount_residual"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </t>
                </table>
            </xpath>

        </template>


        <template id="invoice_informations_block_cubaelect"
                  inherit_id="pyxel_cem_sale.invoice_informations_block">

            <xpath expr="//div[@id='informations_cem']" position="replace">

                <!-- Fila superior: Referencia empresa | NIT+REEUP | No.Factura+Fecha -->
                <table class="table importes-table" style="border:none">
                    <tbody style="border:none">
                        <tr style="border:none">
                            <td style="border:none; width:30%">
                                <strong>Referencia:</strong>
                                <span t-esc="', '.join(filter(None, [
                                    o.company_id.name,
                                    o.company_id.street,
                                    o.company_id.street2,
                                    o.company_id.city,
                                    (o.company_id.state_id and o.company_id.state_id.name) or '',
                                    o.company_id.zip,
                                    (o.company_id.country_id and o.company_id.country_id.name) or ''
                                ]))" style="white-space: nowrap;"/>
                            </td>
                            <td style="border:none;">
                                <strong>NIT:</strong>
                                <span>
                                    <t t-esc="o.company_id.nit"/>
                                </span>
                                <br/>
                                <strong>REEUP:</strong>
                                <span>
                                    <t t-esc="o.company_id.reeup"/>
                                </span>
                            </td>
                            <td style="border:none;">
                                <strong>No. Factura:</strong>
                                <span>
                                    <t t-if="o and o.name" t-esc="o.name"/>
                                </span>
                                <br/>
                                <strong>Fecha:</strong>
                                <span>
                                    <t t-if="o and o.invoice_date"
                                       t-esc="o.invoice_date"/>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <br/>
                <br/>

                <!-- Grid 2 columnas: datos del cliente -->
                <div id="informations" class="row mt-3 mb-1"
                     style="display:grid; grid-template-columns:1fr 1fr">
                    <div>
                        <div>
                            <strong>Cliente:</strong>
                            <span t-field="o.partner_id.name"
                                  style="white-space: nowrap;"/>
                        </div>
                        <div>
                            <strong>Teléfono:</strong>
                            <span t-field="o.partner_id.phone"
                                  style="white-space: nowrap;"/>
                        </div>
                        <div>
                            <strong>Dirección:</strong>
                            <span t-esc="', '.join(filter(None, [
                                o.partner_id.street,
                                o.partner_id.street2,
                                o.partner_id.city,
                                (o.partner_id.state_id and o.partner_id.state_id.name) or '',
                                o.partner_id.zip,
                                (o.partner_id.country_id and o.partner_id.country_id.name) or ''
                            ]))" style="white-space: nowrap;"/>
                        </div>
                    </div>
                </div>
                <br/>
                <br/>

            </xpath>
        </template>


        <template id="invoice_payment_details_block_cubaelect"
                  inherit_id="pyxel_cem_sale.invoice_payment_details_block">
            <xpath expr="//div[contains(@class, 'payment-details')]"
                   position="replace"/>
            <!-- Bloque de pago eliminado: cubaelectronica no lo requiere -->
        </template>


    </data>
</odoo>