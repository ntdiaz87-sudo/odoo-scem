<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paper Format -->
        <record id="paperformat_submayor_report" model="report.paperformat">
            <field name="name">Submayor de Vacaciones</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">10</field>
            <field name="dpi">96</field>
        </record>

        <record id="report_hr_submayor_report_view" model="ir.actions.report">
            <field name="name">HR Submayor Report</field>
            <field name="model">hr.submayor.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_cu_hr_payroll_submayor.report_hr_submayor</field>
            <field name="report_file">l10n_cu_hr_payroll_submayor.report_hr_submayor</field>
            <field name="print_report_name">Submayor de vacaciones de '%s' % object.employee_id.name</field>
            <field name="binding_model_id" ref="model_hr_submayor_report"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_submayor_report"/>
        </record>

        <template id="l10n_cu_hr_payroll_submayor.report_hr_submayor">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">

                        <div class="text-center">
                            <h2>SUBMAYOR DE VACACIONES</h2>

                            <strong>
                                <t t-out="employee_name or ''"/>
                            </strong>
                        </div>

                        <!-- Orderlines -->
                        <h4>Acumulados</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Nomina</th>
                                    <th>Días</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach='submayor' t-as='line'>

                                    <td>
                                        <t t-out="line.name" />
                                    </td>
                                    <td>
                                        <t t-out="line.work_days" />
                                    </td>
                                    <td>
                                        <t t-out='line.amount' />
                                    </td>

                                </tr>
                            </tbody>
                        </table>

                        <br/>
                        <br/>
                        <br/>

                        <strong>Total en Dias: <t t-out='total_days' />
                        </strong><br/>
                        <strong>Total Acumulado: <t t-out='total_amount' />
                        </strong>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>