<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View hr.submayor.report wizard form -->
    <record id="view_hr_submayor_report_form" model="ir.ui.view">
        <field name="name">view.hr.submayor.report.form</field>
        <field name="model">hr.submayor.report</field>
        <field name="arch" type="xml">
            <form string="Submayor de Vacaciones">
                <div class="oe_title">
                    <label for="employee_id"/>
                    <h1>
                        <field name="employee_id" 
                        required="1"
                         />
                    </h1>
                </div>
                
                <footer>
                    <button name="add" type="object" string="Add" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action hr.submayor.report -->
    <record id="action_hr_submayor_report" model="ir.actions.act_window">
        <field name="name">Acumulado de Vacaciones de un Empleado</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.submayor.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hr_payslip_payment"
			  action="action_hr_submayor_report"
			  parent="l10n_cu_hr_payroll_submayor.menu_payslip_submayor"/>

</odoo>
