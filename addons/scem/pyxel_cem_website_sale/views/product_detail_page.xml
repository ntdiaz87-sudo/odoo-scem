<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- CAROUSEL PRODUCT - Compatible -->
        <record id="shop_product_carousel" model="ir.ui.view">
            <field name="name">product carousel custom</field>
            <field name="model">ir.ui.view</field>
            <field name="inherit_id" ref="website_sale.shop_product_carousel"/>
            <field name="type">qweb</field>
            <field name="key">pyxel_cem_website_sale.shop_product_carousel</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='o-carousel-product']/div" position="attributes">
                    <attribute name="style">border: 1px solid #3a3737 !important;border-radius: 20px !important;
                    </attribute>
                </xpath>
            </field>
        </record>

        <!-- PRODUCT DETAIL - Compatible Community & Enterprise -->
        <record id="product" model="ir.ui.view">
            <field name="name">product</field>
            <field name="inherit_id" search="[('key', '=', 'website_sale.product')]"/>
            <field name="type">qweb</field>
            <field name="key">product_extended.product</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='product_details']" position="replace">

                    <div t-attf-class="col-lg-#{image_cols[1]} mt-md-4" id="product_details">
                        <t t-set="base_url" t-value="product.get_base_url()"/>
                        <h1 itemprop="name" t-field="product.large_name">Product Name</h1>
                        <span itemprop="url" style="display:none;" t-esc="base_url + product.website_url"/>
                        <span itemprop="image" style="display:none;"
                              t-esc="base_url + website.image_url(product, 'image_1920')"/>

                        <div class="o_product_page_reviews_link text-decoration-none">
                            <t t-call="portal_rating.rating_widget_stars_static">
                                <t t-set="rating_avg" t-value="product.rating_avg"/>
                                <t t-set="trans_text_plural" t-value="'%s reviews'"/>
                                <t t-set="trans_text_singular" t-value="'%s review'"/>
                                <t t-set="rating_count"
                                   t-value="'%s reseñas' % product.rating_count if product.rating_count > 1 else '%s reseña' % product.rating_count"/>
                            </t>
                            <span t-esc="rating_count"/>
                        </div>

                        <p t-field="product.description_sale" class="text-muted my-2"
                           placeholder="A short description that will also appear on documents."/>
                        <div t-field="product.description_ecommerce" class="oe_structure"
                             placeholder="A detailed, formatted description to promote your product on this page. Use '/' to discover more features."/>

                        <form id="add_to_cart_form" t-if="product._is_add_to_cart_possible()" action="/shop/cart/update"
                              method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"
                                   t-nocache="The csrf token must always be up to date."/>
                            <input type="hidden" name="available_qty" t-att-value="product_variant.qty_available"/>

                            <div class="js_product js_main_product mb-3" style="position: relative">
                                <div class="price-card">
                                    <div id="price_container" style="margin-bottom: 10px;">
                                        <t t-call="website_sale.product_price"/>
                                        <small t-if="combination_info['base_unit_price']"
                                               class="ms-1 text-muted o_base_unit_price_wrapper d-none"
                                               groups="website_sale.group_show_uom_price">
                                            <t t-esc="'{:,.2f}'.format(float(combination_info['base_unit_price'])).replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                        </small>
                                    </div>
                                    <t t-placeholder="select">
                                        <input type="hidden" class="product_id" name="product_id"
                                               t-att-value="product_variant.id"/>
                                        <input type="hidden" class="product_template_id" name="product_template_id"
                                               t-att-value="product.id"/>
                                        <input t-if="product.public_categ_ids.ids" type="hidden"
                                               class="product_category_id" name="product_category_id"
                                               t-att-value="product.public_categ_ids.ids[0]"/>
                                        <t t-call="website_sale.variants">
                                            <t t-set="ul_class" t-valuef="flex-column"/>
                                            <t t-set="parent_combination" t-value="None"/>
                                        </t>
                                    </t>
                                    <p t-if="True" class="css_not_available_msg alert alert-warning">This combination
                                        does not exist.
                                    </p>

                                    <div id="o_wsale_cta_wrapper">
                                        <t t-set="hasQuantities" t-value="false"/>
                                        <t t-set="hasBuyNow" t-value="false"/>
                                        <t t-set="ctaSizeBig" t-value="not hasQuantities or not hasBuyNow"/>

                                        <div class="price-container">
                                            <div class="counter-btns">
                                                <div class="me-2 counter-container">
                                                    <button type="button"
                                                            class="btn border minus_btn btn-less-detail btn-less">-
                                                    </button>
                                                    <input
                                                            type="number"
                                                            class="form-control text-center detail-counter counter-qty"
                                                            name="add_qty"
                                                            t-att-value="product_variant.sale_min_qty or product.sale_min_qty or 1"
                                                            t-att-min="product_variant.sale_min_qty or product.sale_min_qty or 1"
                                                            t-att-data-sale-min-qty="product_variant.sale_min_qty or product.sale_min_qty or 1"
                                                    />
                                                    <button type="button"
                                                            class="btn border plus_btn btn-more-detail btn-more">+
                                                    </button>
                                                </div>
                                            </div>

                                            <div id="add_to_cart_wrap"
                                                 t-attf-class="{{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-flex'}} align-items-center">
                                                <button type="submit" id="add_to_cart"
                                                        t-attf-class="btn btn-primary js_check_product a-submit flex-grow-1 js_add_to_cart"
                                                        data-animation-selector=".o_wsale_product_images">
                                                    Add
                                                </button>
                                            </div>
                                        </div>

                                        <div id="product_option_block" class="d-flex flex-wrap w-100"/>
                                    </div>

                                    <div id="qty-warning-message" class="text-danger d-none"></div>
                                </div>

                                <div id="contact_us_wrapper"
                                     t-attf-class="{{'d-flex' if combination_info['prevent_zero_price_sale'] else 'd-none'}} oe_structure oe_structure_solo #{_div_classes}">
                                    <section class="s_text_block" data-snippet="s_text_block" data-name="Text">
                                        <div class="container">
                                            <a t-att-href="website.contact_us_button_url"
                                               class="btn btn-primary btn_cta">Contact Us
                                            </a>
                                        </div>
                                    </section>
                                </div>

                                <t t-if="is_view_active('website_sale.product_tags')"
                                   t-call="website_sale.product_tags">
                                    <t t-set="all_product_tags" t-value="product_variant.all_product_tag_ids"/>
                                </t>
                            </div>
                        </form>

                        <p t-elif="not product.active" class="alert alert-warning">This product is no longer
                            available.
                        </p>
                        <p t-else="" class="alert alert-warning">This product has no valid combination.</p>

                        <div id="product_attributes_simple">
                            <t t-set="single_value_attributes"
                               t-value="product.valid_product_template_attribute_line_ids._prepare_single_value_for_display()"/>
                            <table t-attf-class="table table-sm text-muted {{'' if single_value_attributes else 'd-none'}}">
                                <t t-foreach="single_value_attributes" t-as="attribute">
                                    <tr>
                                        <td>
                                            <span t-field="attribute.name"/>:
                                            <t t-foreach="single_value_attributes[attribute]" t-as="ptal">
                                                <span t-field="ptal.product_template_value_ids._only_active().name"/>
                                                <t t-if="not ptal_last">,</t>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>

                        <div id="product-info-container">
                            <div class="left-product-info">
                                <t t-if="product.nom_code">
                                    <strong>Nomenclature code:</strong>
                                    <t t-esc="product.nom_code"/>
                                    <br/>
                                    <br/>
                                </t>

                                <t t-if="product.origin_id">
                                    <strong>Origin of the load:</strong>
                                    <t t-esc="product.origin_id.name"/>
                                    <br/>
                                    <br/>
                                </t>

                                <t t-if="product_variant.qty_available">
                                    <strong>Quantity available:</strong>
                                    <span id="available-qty-display">
                                        <t t-esc="int(product_variant.qty_available)"/>
                                    </span>
                                    <span id="uom-name">
                                        <t t-esc="product_variant.sudo().uom_id.name"/>
                                    </span>
                                    <br/>
                                    <br/>
                                </t>

                                <t t-if="product.uom_reference">
                                    <strong>Quantity reference:</strong>
                                    <span t-field="product.uom_reference"/>
                                    <br/>
                                    <br/>
                                </t>

                                <t t-if="product.mark_id.name">
                                    <strong>Brand:</strong>
                                    <t t-esc="product.mark_id.name"/>
                                    <br/>
                                    <br/>
                                </t>
                            </div>

                            <div class="right-product-info">
                                <t t-set="product_documents"
                                   t-value="product.sudo().product_document_ids.filtered(lambda doc: doc.shown_on_product_page)"/>
                                <div id="product_documents" t-if="product_documents">
                                    <strong>Technical Sheet:</strong>
                                    <t t-foreach="product_documents" t-as="document_sudo">
                                        <t t-set="attachment_sudo" t-value="document_sudo.ir_attachment_id"/>
                                        <t t-set="target"
                                           t-value="attachment_sudo.type == 'url' and '_blank' or '_self'"/>
                                        <t t-set="icon"
                                           t-value="attachment_sudo.type == 'url' and 'fa-link' or 'fa-download'"/>
                                        <div>
                                            <a t-att-href="'/shop/' + slug(product) + '/document/' + str(document_sudo.id)"
                                               t-att-target="target">
                                                <i t-att-class="'fa ' + icon"/>
                                                <t t-out="attachment_sudo.name"/>
                                            </a>
                                        </div>
                                    </t>
                                    <br/>
                                </div>

                                <t t-if="product.provider_id">
                                    <div class="term-cond">
                                        <t t-if="product.terms_cond">
                                            <strong>Terms and conditions:</strong>
                                            <span t-field="product.terms_cond"/>
                                        </t>
                                    </div>

                                    <strong>Sale for:</strong>
                                    <img t-att-src="'/web/image/res.partner/' + str(product.provider_id.id) + '/image_1920'"
                                         alt="Foto del Proveedor" class="img-fluid provider-img"/>
                                    <br/>
                                    <br/>
                                </t>

                                <div>
                                    <div class="row mb-2 g-0 align-items-center">
                                        <div class="col-auto">
                                            <strong>Share:</strong>
                                        </div>
                                        <div class="col-auto">
                                            <t t-snippet-call="website.s_share">
                                                <t t-set="_exclude_share_links" t-value="['whatsapp', 'linkedin']"/>
                                                <t t-set="_no_title" t-value="True"/>
                                                <t t-set="_classes" t-valuef="text-lg-end"/>
                                                <t t-set="_link_classes" t-valuef="mx-2 my-0"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="o_product_terms_and_share"
                             class="d-flex justify-content-between flex-column flex-md-row align-items-md-end mb-3">
                        </div>
                    </div>
                </xpath>

                <!-- Reemplazar description -->
                <xpath expr="//div[@itemprop='description']" position="replace">
                    <div class="tab-pane" id="website_description">
                        <div class="row mt-5 justify-content-center">
                            <div class="col-12 col-md-10 col-lg-8">
                                <div class="specs-reviews-tabs card">

                                    <!-- ===== CABECERA CON TABS ===== -->
                                    <div class="card-header p-0"
                                         style="background: white; border-bottom: 2px solid #e9ecef;">

                                        <!-- ✅ FIX: estilos para tab activo en azul claro -->
                                        <style>
                                            #specsReviewsTabs .nav-link {
                                            color: #666;
                                            border: none;
                                            border-bottom: 3px solid transparent !important;
                                            background: none;
                                            transition: color 0.2s, border-color 0.2s;
                                            }
                                            #specsReviewsTabs .nav-link:hover {
                                            color: #666666;
                                            border-bottom-color: #a8c8f8 !important;
                                            }
                                            #specsReviewsTabs .nav-link.active,
                                            #specsReviewsTabs .nav-link.active:focus {
                                            color: #309DF4 !important;
                                            font-weight: 700 !important;
                                            border-bottom: 3px solid #309DF4 !important;
                                            background: none !important;
                                            }


                                            /* ===== COUNTER CONTAINER - Fix botón + dentro del div ===== */
                                            .counter-container {
                                            display: flex !important;
                                            flex-direction: row !important;
                                            align-items: center !important;
                                            border: 1px solid #dee2e6;
                                            border-radius: 50px;
                                            overflow: hidden;
                                            background: white;
                                            width: fit-content;
                                            }

                                            .counter-container .btn-less,
                                            .counter-container .btn-more {
                                            border: none !important;
                                            border-radius: 0 !important;
                                            background: transparent;
                                            width: 32px;
                                            height: 36px;
                                            padding: 0;
                                            line-height: 1;
                                            flex-shrink: 0;
                                            }

                                            .counter-container .btn-less:hover,
                                            .counter-container .btn-more:hover {
                                            background-color: #f0f0f0;
                                            }

                                            .counter-container input[type="number"] {
                                            border: none !important;
                                            border-left: 1px solid #dee2e6 !important;
                                            border-right: 1px solid #dee2e6 !important;
                                            border-radius: 0 !important;
                                            width: 45px !important;
                                            height: 36px;
                                            padding: 0 !important;
                                            text-align: center;
                                            box-shadow: none !important;
                                            -moz-appearance: textfield;
                                            }

                                            .counter-container input[type="number"]::-webkit-inner-spin-button,
                                            .counter-container input[type="number"]::-webkit-outer-spin-button {
                                            -webkit-appearance: none;
                                            margin: 0;
                                            }

                                            .price-container {
                                            display: flex !important;
                                            align-items: center !important;
                                            gap: 10px;
                                            flex-wrap: nowrap;
                                            }

                                            .counter-btns {
                                            display: flex;
                                            align-items: center;
                                            }
                                        </style>

                                        <ul class="nav nav-tabs border-0" id="specsReviewsTabs" role="tablist"
                                            style="padding: 0 20px; margin-bottom: -2px;">

                                            <!-- Tab: Descripción -->
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link active" id="description-tab"
                                                        data-bs-toggle="tab"
                                                        data-bs-target="#description-content"
                                                        type="button" role="tab"
                                                        style="padding: 15px 25px; font-weight: 600;">
                                                    Descripción
                                                </button>
                                            </li>

                                            <!-- Tab: Especificaciones -->
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="specs-tab"
                                                        data-bs-toggle="tab"
                                                        data-bs-target="#specs-content"
                                                        type="button" role="tab"
                                                        style="padding: 15px 25px; font-weight: 600;">
                                                    Especificaciones
                                                </button>
                                            </li>

                                            <!-- Tab: Documentos (condicional) -->
                                            <t t-set="product_documents_ids"
                                               t-value="product.sudo().product_document_ids.filtered(lambda doc: doc.shown_on_product_page)"/>
                                            <li t-if="product_documents_ids" class="nav-item" role="presentation">
                                                <button class="nav-link" id="documents-tab"
                                                        data-bs-toggle="tab"
                                                        data-bs-target="#documents-content"
                                                        type="button" role="tab"
                                                        style="padding: 15px 25px; font-weight: 600;">
                                                    Documentos
                                                </button>
                                            </li>

                                            <!-- Tab: Valoraciones -->
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="reviews-tab"
                                                        data-bs-toggle="tab"
                                                        data-bs-target="#reviews-content"
                                                        type="button" role="tab"
                                                        style="padding: 15px 25px; font-weight: 600;">
                                                    Valoraciones
                                                    <t t-if="len(product.website_message_ids)">
                                                        <span class="badge bg-secondary ms-2" style="font-size: 12px;">
                                                            <t t-esc="len(product.website_message_ids)"/>
                                                        </span>
                                                    </t>
                                                </button>
                                            </li>

                                        </ul>
                                    </div>

                                    <!-- ===== CONTENIDO DE LOS TABS ===== -->
                                    <div class="card-body p-0">
                                        <div class="tab-content" id="specsReviewsContent">

                                            <!-- CONTENIDO: Descripción -->
                                            <div class="tab-pane fade show active" id="description-content"
                                                 role="tabpanel" aria-labelledby="description-tab">
                                                <div class="p-4">
                                                    <div id="product_full_description" style="white-space: pre-wrap;">
                                                        <t t-if="product.full_description">
                                                            <t t-if="len(product.full_description) &gt; 350">
                                                                <div class="oe_structure oe_empty mt16 short_description">
                                                                    <t t-esc="product.full_description[:350] + '...'"/>
                                                                </div>
                                                                <div style="display: none;"
                                                                     class="oe_structure oe_empty mt16 completed_description">
                                                                    <t t-esc="product.full_description"/>
                                                                </div>
                                                                <button type="button" id="toggle_description_internal"
                                                                        class="btn btn-link">Leer más
                                                                </button>
                                                                <script type="text/javascript">
                                                                    document.addEventListener('DOMContentLoaded',
                                                                    function() {
                                                                    var btn =
                                                                    document.getElementById('toggle_description_internal');
                                                                    if (btn) {
                                                                    btn.addEventListener('click', function() {
                                                                    var shortDesc =
                                                                    document.querySelector('.short_description');
                                                                    var fullDesc =
                                                                    document.querySelector('.completed_description');
                                                                    if (fullDesc.style.display === 'none') {
                                                                    fullDesc.style.display = 'block';
                                                                    shortDesc.style.display = 'none';
                                                                    btn.textContent = 'Leer menos';
                                                                    } else {
                                                                    fullDesc.style.display = 'none';
                                                                    shortDesc.style.display = 'block';
                                                                    btn.textContent = 'Leer más';
                                                                    }
                                                                    });
                                                                    }
                                                                    });
                                                                </script>
                                                            </t>
                                                            <t t-else="">
                                                                <div class="oe_structure oe_empty mt16">
                                                                    <t t-esc="product.full_description"/>
                                                                </div>
                                                            </t>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- CONTENIDO: Especificaciones -->
                                            <div class="tab-pane fade" id="specs-content"
                                                 role="tabpanel" aria-labelledby="specs-tab">
                                                <div class="p-4">
                                                    <div id="product_specifications">
                                                        <div class="row">
                                                            <t t-set="categories"
                                                               t-value="product.valid_product_template_attribute_line_ids._prepare_categories_for_display()"/>
                                                            <t t-foreach="categories" t-as="category">
                                                                <div class="col-lg-6">
                                                                    <table class="table">
                                                                        <t t-if="len(categories) > 1">
                                                                            <tr>
                                                                                <th class="text-start"
                                                                                    t-att-colspan="2">
                                                                                    <span t-if="category"
                                                                                          t-field="category.name"/>
                                                                                    <span t-else="">Sin categoría</span>
                                                                                </th>
                                                                            </tr>
                                                                        </t>
                                                                        <tr t-foreach="categories[category].filtered(lambda l: len(l.value_ids) > 1)"
                                                                            t-as="ptal">
                                                                            <td class="w-25">
                                                                                <span t-field="ptal.attribute_id.name"/>
                                                                            </td>
                                                                            <td class="w-75 text-muted">
                                                                                <t t-foreach="ptal.value_ids"
                                                                                   t-as="pav">
                                                                                    <span t-field="pav.name"/>
                                                                                    <t t-if="not pav_last">o</t>
                                                                                </t>
                                                                            </td>
                                                                        </tr>
                                                                        <t t-set="single_value_attributes"
                                                                           t-value="categories[category]._prepare_single_value_for_display()"/>
                                                                        <tr t-foreach="single_value_attributes"
                                                                            t-as="attribute">
                                                                            <td class="w-25">
                                                                                <span t-field="attribute.name"/>
                                                                            </td>
                                                                            <td class="w-75 text-muted">
                                                                                <t t-foreach="single_value_attributes[attribute]"
                                                                                   t-as="ptal">
                                                                                    <span t-field="ptal.product_template_value_ids._only_active().name"/>
                                                                                    <t t-if="not ptal_last">,</t>
                                                                                </t>
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </t>

                                                            <!-- Tags (condicional) -->
                                                            <t t-if="is_view_active('website_sale.product_tags')">
                                                                <div class="col-lg-6">
                                                                    <table class="table">
                                                                        <t t-if="product.product_variant_ids.all_product_tag_ids">
                                                                            <tr>
                                                                                <th class="text-start"
                                                                                    t-att-colspan="2">
                                                                                    <span>Etiquetas</span>
                                                                                </th>
                                                                            </tr>
                                                                            <tr class="d-flex">
                                                                                <td class="w-25 d-flex align-items-center">
                                                                                    <span>Etiquetas</span>
                                                                                </td>
                                                                                <td class="w-75 text-muted">
                                                                                    <t t-call="website_sale.product_tags">
                                                                                        <t t-set="all_product_tags"
                                                                                           t-value="product.product_variant_ids.all_product_tag_ids"/>
                                                                                    </t>
                                                                                </td>
                                                                            </tr>
                                                                        </t>
                                                                    </table>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- CONTENIDO: Documentos (condicional) -->
                                            <div t-if="product_documents_ids" class="tab-pane fade"
                                                 id="documents-content"
                                                 role="tabpanel" aria-labelledby="documents-tab">
                                                <div class="p-4">
                                                    <div class="row pt-2 pb-4 m-0">
                                                        <t t-foreach="product_documents_ids" t-as="document_sudo">
                                                            <t t-set="attachment_sudo"
                                                               t-value="document_sudo.ir_attachment_id"/>
                                                            <t t-set="target"
                                                               t-value="attachment_sudo.type == 'url' and '_blank' or '_self'"/>
                                                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 my-2">
                                                                <div class="d-flex align-items-center p-2 border">
                                                                    <div class="o_image"
                                                                         t-att-data-mimetype="attachment_sudo.mimetype"/>
                                                                    <div class="ms-2 text-truncate">
                                                                        <div t-field="attachment_sudo.name"
                                                                             t-att-title="attachment_sudo.name"/>
                                                                        <a t-att-href="'/shop/' + slug(product) + '/document/' + str(document_sudo.id)"
                                                                           t-att-target="target"
                                                                           class="link-primary d-inline-block mt-1">
                                                                            <i class="fa fa-download"/>
                                                                            Descargar
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- CONTENIDO: Valoraciones / Reviews -->
                                            <div class="tab-pane fade" id="reviews-content"
                                                 role="tabpanel" aria-labelledby="reviews-tab">
                                                <div class="p-4">
                                                    <t t-call="portal.message_thread">
                                                        <t t-set="object" t-value="product"/>
                                                        <t t-set="display_rating" t-value="True"/>
                                                        <t t-set="message_per_page" t-value="5"/>
                                                        <t t-set="two_columns" t-value="true"/>
                                                    </t>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                    <!-- fin card-body -->

                                </div>
                                <!-- fin card -->
                            </div>
                            <!-- fin col -->
                        </div>
                        <!-- fin row -->
                    </div>
                    <br/>
                </xpath>
            </field>
        </record>

        <!-- VARIANTS - Add attributes to options -->
        <record id="variants" model="ir.ui.view">
            <field name="name">variants custom attributes</field>
            <field name="model">ir.ui.view</field>
            <field name="inherit_id" ref="website_sale.variants"/>
            <field name="type">qweb</field>
            <field name="key">pyxel_cem_website_sale.variants</field>
            <field name="arch" type="xml">
                <xpath expr="//option" position="attributes">
                    <attribute name="t-att-data-uom_min">ptav.uom_min</attribute>
                    <attribute name="t-att-data-is_uom_min">ptav.is_uom_min and 'true' or 'false'</attribute>
                </xpath>
            </field>
        </record>

        <!-- Desactivar vistas originales -->
        <record id="website_sale.product_custom_text" model="ir.ui.view">
            <field name="active" eval="False"/>
        </record>

        <record id="website_sale.product_share_buttons" model="ir.ui.view">
            <field name="active" eval="False"/>
        </record>

        <record id="divep_product_detail_button" model="ir.ui.view">
            <field name="name">divep.product.detail.button</field>
            <field name="model">ir.ui.view</field>
            <field name="inherit_id" ref="pyxel_cem_website_sale.product"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@id='add_to_cart']" position="attributes">
                    <attribute name="t-att-data-product-id">product.id</attribute>
                    <attribute name="t-att-data-product-type">product.product_wsale_type</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>