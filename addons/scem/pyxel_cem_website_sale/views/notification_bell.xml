<odoo>
    <!-- Versión Escritorio -->
    <template id="notification_bell" inherit_id="website_sale.header_cart_link">
        <xpath expr="//t[@t-nocache]" position="inside">
             <t t-if="request.env.user and not request.env.user.has_group('base.group_public')">
                <li id="notification-bell-desktop" class="nav-item o_notification_bell">
                    <!-- El contenido será insertado por JavaScript -->
                    <!--                    <i class="fa fa-spinner fa-spin"/>-->
                </li>
            </t>
        </xpath>
    </template>

    <!-- Versión Movil -->
    <template id="notification_bell_mobile" inherit_id="website_sale.header_cart_link">
        <xpath expr="//t[@t-nocache]" position="inside">
             <t t-if="request.env.user and not request.env.user.has_group('base.group_public')">
                <li id="notification-bell-mobile" class="o_notification_bell">
                    <!-- OWL se montará aquí -->
                </li>
            </t>
        </xpath>
    </template>

