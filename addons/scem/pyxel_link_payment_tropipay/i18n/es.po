#. module: pyxel_link_payment_tropipay
#: model:mail.template,body_html:pyxel_link_payment_tropipay.mail_template_sale_confirmation_custom
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Dear <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>.\n"
"                        <br>\n"
"                        <br>\n"
"                        Your order <span style=\"font-weight:bold;\" t-out=\"object.name or ''\"></span> has been confirmed.\n"
"                        <br>\n"
"                        Thank you for your trust!.\n"
"                        <br>\n"
"                        <br>\n"
"                        Do payment by: <span style=\"font-weight:bold;\" t-out=\"object.payment_meth_id.name or ''\"></span>.\n"
"                        <br>\n"
"                        Payment Link: <a t-attf-href=\"{{object.tpp_link}}\" target=\"_blank\"><span style=\"color:#1A0DAB\" t-out=\"object.tpp_link\"></span></a>\n"
"                        <br>\n"
"                        This link expire on: <span style=\"font-weight:bold;\" t-out=\"object.tpp_link_exp_date_str or ''\"></span>.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Estimado/a <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>.\n"
"                        <br>\n"
"                        <br>\n"
"                        Su pedido ha sido confirmado.\n"
"                        <br>\n"
"                        Agradecemos su confianza.\n"
"                        <br>\n"
"                        <br>\n"
"                        Realizar el pago por: <span style=\"font-weight:bold;\" t-out=\"object.payment_meth_id.name or ''\"></span>\n"
"                        <br>\n"
"                        Enlace de pago: <a t-attf-href=\"{{object.tpp_link}}\" target=\"_blank\"><span style=\"color:#1A0DAB\" t-out=\"object.tpp_link\"></span></a>\n"
"                        <br>\n"
"                        Este enlace expira el: <span style=\"font-weight:bold;\" t-out=\"object.tpp_link_exp_date_str or ''\"></span>.\n"
"                    </p>\n"
"                </div>\n"
"            "

