<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="view_partner_cem_vc_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.cem.virtual.contract.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <field name="active_vc_ids" invisible="1"/>
                    <button name="action_view_active_vc"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="not active_vc_ids">
                        View Active Contract
                    </button>
                </div>
                <field name="category_id" position="after">
                    <field name="cem_abbreviations"/>
                </field>
            </field>
        </record>

    </data>
</odoo>


