<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_garantia_pago" model="ir.ui.view">
        <field name="name">sale.order.form.garantia_pago</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_meth_id']" position="after">
                <field name="is_supplier_payment"
                       string="Pago al Proveedor"
                       readonly="is_form_readonly"
                       force_save="1"/>
            </xpath>

            <!-- Insertar debajo del campo Cliente -->
            <xpath expr="//group[@name='sale_header']" position="after">

                <field name="is_form_readonly" invisible="1"/>

                <!-- Gestión de Pagos -->
                <group string="Gestión de Pago" name="group_gestion_pago" colspan="4"
                       invisible="not is_supplier_payment">

                    <field name="supplier_partner_id"
                           invisible="not is_supplier_payment"
                           required="is_supplier_payment"
                           readonly="is_form_readonly"
                           force_save="1"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="supplier_bank_account_ids" invisible="1"/>
                    <field name="supplier_bank_account_id"
                           invisible="not is_supplier_payment"
                           readonly="is_form_readonly"
                           force_save="1"
                           widget="selection"
                           options="{'no_create': True, 'no_open': True}">
                        <tree>
                            <field name="acc_number"/>
                            <field name="currency_id"/>
                            <field name="acc_type"/>
                        </tree>
                    </field>
                    <field name="supplier_acc_number"
                           invisible="not supplier_bank_account_id"
                           readonly="1"/>
                    <field name="supplier_currency_id"
                           invisible="not supplier_bank_account_id"
                           readonly="1"/>
                    <field name="supplier_account_type"
                           invisible="not supplier_bank_account_id"
                           readonly="1"/>
                    <field name="supplier_titular_id"
                           invisible="not supplier_bank_account_id"
                           readonly="1"/>
                    <field name="supplier_swift_code"
                           invisible="not supplier_bank_account_id"
                           readonly="1"/>
                    <field name="supplier_bank_id"
                           invisible="not supplier_bank_account_id"
                           readonly="1"/>
                </group>

            </xpath>

            <xpath expr="//field[@name='payment_prov_id']" position="attributes">
                <attribute name="readonly">is_supplier_payment == True</attribute>
            </xpath>


            <xpath expr="//field[@name='payment_meth_id']" position="attributes">
                <attribute name="readonly">is_supplier_payment == True</attribute>
            </xpath>


        </field>
    </record>
</odoo>