                    </group> 

                    <br/>
                    <br/>

                    <h2>Banner Promo</h2>
                    <group>
                        <field name="promo_image_1" widget="image" class="oe_avatar"/>
                        <field name="promo_image_responsive_1" widget="image" class="oe_avatar"/>
                        <field name="promo_url_1"/>
                        <field name="promo_title_1"/>
                        <field name="promo_text_1"/>
                        <field name="promo_button_1"/>
                    </group>

                    <group>
                        <field name="promo_image_2" widget="image" class="oe_avatar"/>
                        <field name="promo_image_responsive_2" widget="image" class="oe_avatar"/>
