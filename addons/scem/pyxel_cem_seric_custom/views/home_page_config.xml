<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acreditation_url_form" model="ir.ui.view">
        <field name="name">acreditation.url.form</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Home Configuration" name="acreditation_url" groups="base.group_no_one">
