                    </group>
                    <br/>

                    <h5>Slide 2</h5>
                    <group>
                        <field name="banner_image_2" widget="image" class="oe_avatar"/>
                        <!-- <field name="responsive_banner_image_2" widget="image" class="oe_avatar"/> -->
                        <field name="title_banner_2"/>
                        <field name="category_banner_2"/>
                        <field name="description_banner_2"/>
