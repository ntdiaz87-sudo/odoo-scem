                        <field name="url_services_1"/>
                    </group> 
                    <group>
                        <field name="img_services_2" widget="image" class="oe_avatar"/>
                        <field name="title_services_2"/>
                        <field name="url_services_2"/>
                    </group> 
                    <group>
                        <field name="img_services_3" widget="image" class="oe_avatar"/>
                        <field name="title_services_3"/>
                        <field name="url_services_3"/>
                    </group> 
                    <group>
                        <field name="img_services_4" widget="image" class="oe_avatar"/>
