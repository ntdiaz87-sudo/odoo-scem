                            <a href="/about/seric#tracking" style="padding-left: 10px;">• ¿Cómo rastrear mi pedido?</a>
                            <a href="/about/seric#time" style="padding-left: 10px;">• Tiempos de espera</a>
                            <a href="/about/seric#tarifa" style="padding-left: 10px;">• Tarifa de envíos</a>
                            <a href="/about/seric#contact" style="padding-left: 10px;">• ¿Quiero contactar con un comercial de SERIC?</a>
                            <a href="" style="padding-left: 10px;">• Mapa del sitio</a>
                        </div>
                        <div class="footer-column newsletter">
                            <strong>Suscríbete</strong>
                            <div style="position: relative;">
                                <form t-att-action="'/subscribe_newsletter'" method="post" class="d-flex align-items-center mt-2">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <input
                                        name="email"
                                        type="email"
                                        placeholder="tu correo..."
                                        required="required"
                                        style="border-radius: 5px; border: 1px solid white; color: black; padding-left: 0.5rem;"
                                    />

                                    <button type="submit" class="footer-button ml-2">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <g clip-path="url(#clip0_892_850)">
                                            <path d="M14.6673 1.3335L7.33398 8.66683" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            <path d="M14.6673 1.3335L10.0007 14.6668L7.33398 8.66683L1.33398 6.00016L14.6673 1.3335Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </g>
                                            <defs>
                                            <clipPath id="clip0_892_850">
                                            <rect width="16" height="16" fill="white"/>
                                            </clipPath>
                                            </defs>
                                        </svg>
                                    </button>
                                </form>
                            </div>

                            <strong>Métodos de pago</strong>
                                <div class="payment-methods-img">
                                <img  src="/pyxel_cem_seric_custom/static/src/img/pay_meth_1.svg"/>
                                <img  src="/pyxel_cem_seric_custom/static/src/img/pay_meth_2.svg"/>
                                <img  src="/pyxel_cem_seric_custom/static/src/img/pay_meth_3.svg"/>
                                <img  src="/pyxel_cem_seric_custom/static/src/img/pay_meth_4.svg"/>
                                <img  src="/pyxel_cem_seric_custom/static/src/img/pay_meth_5.svg"/>
                                </div>
                        </div>
                    </div>

                </xpath>
            </field>
        </record>

