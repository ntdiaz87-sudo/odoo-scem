<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════
         ACCIÓN DE REPORTE PDF
    ══════════════════════════════════════════ -->
    <record id="action_conciliation_report" model="ir.actions.report">
        <field name="name">Acta de Conciliación</field>
        <field name="model">conciliation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pyxel_cem_seller_payment.conciliation_report_template</field>
        <field name="report_file">pyxel_cem_seller_payment.conciliation_report_template</field>
        <field name="binding_model_id" ref="model_conciliation_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ══════════════════════════════════════════
         PLANTILLA QWEB
    ══════════════════════════════════════════ -->
    <template id="conciliation_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="record">
                <t t-call="web.external_layout">

                    <!-- Resolver company -->
                    <t t-if="not company">
                        <t t-if="record and 'company_id' in record and record.company_id.sudo()">
                            <t t-set="company" t-value="record.company_id.sudo()"/>
                        </t>
                        <t t-else="">
                            <t t-set="company" t-value="env.company"/>
                        </t>
                    </t>

                    <!-- Mapas de etiquetas -->
                    <t t-set="month_map" t-value="{
                        '01':'Enero','02':'Febrero','03':'Marzo','04':'Abril',
                        '05':'Mayo','06':'Junio','07':'Julio','08':'Agosto',
                        '09':'Septiembre','10':'Octubre','11':'Noviembre','12':'Diciembre'
                    }"/>
                    <t t-set="origin_map" t-value="{'sale':'Ventas','purchase':'Compras'}"/>

                    <div class="page">

                        <!-- ── Título ── -->
                        <div style="text-align:center; margin-bottom:16px;">
                            <h2 style="text-decoration:underline; font-weight:bold; letter-spacing:1px;">
                                ACTA DE CONCILIACIÓN DE LA TIENDA ONLINE
                                <t t-esc="company.name"/>
                            </h2>
                        </div>

                        <!-- ── Encabezado ── -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:16px;">
                            <tr>
                                <td style="width:30%; padding:4px 8px; font-weight:bold;">MES:</td>
                                <td style="padding:4px 8px;">
                                    <t t-esc="month_map.get(record.month, record.month or '')"/>-<t t-esc="record.start_date.year if record.start_date else ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px; font-weight:bold;">PROVEEDOR:</td>
                                <td style="padding:4px 8px;"><t t-esc="record.provider_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px; font-weight:bold;">VENDEDOR:</td>
                                <td style="padding:4px 8px;"><t t-esc="record.seller_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px; font-weight:bold;">Periodo:</td>
                                <td style="padding:4px 8px;">
                                    <t t-esc="record.start_date"/> — <t t-esc="record.end_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px 8px; font-weight:bold;">Concepto de conciliación</td>
                                <td style="padding:4px 8px;">
                                    <t t-esc="record.concept or ''"/>
                                    <t t-if="record.margin_pct">
                                        (Margen <t t-esc="'%.2f' % record.margin_pct"/>%)
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- ── Tabla de montos ── -->
                        <table style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr style="background:#e8e8e8;">
                                    <th style="border:1px solid #555; padding:8px; text-align:center; width:8%;">No.</th>
                                    <th style="border:1px solid #555; padding:8px; width:42%;">Descripción</th>
                                    <th style="border:1px solid #555; padding:8px; text-align:right; width:25%;">Monto (USD)</th>
                                    <th style="border:1px solid #555; padding:8px; width:25%;">Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Fila 1: Ventas -->
                                <tr>
                                    <td style="border:1px solid #555; padding:10px; text-align:center;">1</td>
                                    <td style="border:1px solid #555; padding:10px;">Ventas</td>
                                    <td style="border:1px solid #555; padding:10px; text-align:right;">
                                        <t t-esc="'{:,.2f}'.format(record.amount_sales or 0.0)"/>
                                    </td>
                                    <td style="border:1px solid #555; padding:10px;">
                                        <t t-esc="record.obs_sales or ''"/>
                                    </td>
                                </tr>
                                <!-- Fila 2: CIF -->
                                <tr>
                                    <td style="border:1px solid #555; padding:10px; text-align:center;">2</td>
                                    <td style="border:1px solid #555; padding:10px;">Cif</td>
                                    <td style="border:1px solid #555; padding:10px; text-align:right;">
                                        <t t-esc="'{:,.2f}'.format(record.amount_cif or 0.0)"/>
                                    </td>
                                    <td style="border:1px solid #555; padding:10px;">
                                        <t t-esc="record.obs_cif or ''"/>
                                    </td>
                                </tr>
                                <!-- Fila 3: Margen -->
                                <tr style="background:#f2fff2;">
                                    <td style="border:1px solid #555; padding:10px; text-align:center;">3</td>
                                    <td style="border:1px solid #555; padding:10px; font-weight:bold;">Margen</td>
                                    <td style="border:2px solid #2ea842; padding:10px; text-align:right; font-weight:bold;">
                                        <t t-esc="'{:,.2f}'.format(record.amount_margin or 0.0)"/>
                                    </td>
                                    <td style="border:1px solid #555; padding:10px;">
                                        <t t-esc="record.obs_margin or ''"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ── Espacio para firmas ── -->
                        <br/><br/><br/><br/><br/><br/>
                        <div style="overflow:hidden; width:100%;">
                            <div style="float:left; width:45%; margin-right:10%;">
                                <p style="padding-top:8px; border-top:1px solid #333;
                                          width:250px; text-align:center;">
                                    <t t-esc="company.name"/>
                                </p>
                            </div>
                            <div style="float:left; width:45%;">
                                <p style="padding-top:8px; border-top:1px solid #333;
                                          width:250px; text-align:center;">
                                    <t t-esc="record.provider_id.name"/>
                                </p>
                            </div>
                        </div>

                    </div><!-- /page -->
                </t>
            </t>
        </t>
    </template>

</odoo>