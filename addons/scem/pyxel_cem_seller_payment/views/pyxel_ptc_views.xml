<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pyxel_pct_form" model="ir.ui.view">
            <field name="name">pyxel.pct.form</field>
            <field name="model">pyxel.pct.report</field>
            <field name="arch" type="xml">
                <form string="Report Form Pyxel-PCT">
                    <sheet>
                        <button string="Imprimir Reporte"
                            type="object"
                            name="action_print_pyxel_report"
                            class="btn-primary"/>
                        <br/>
                        <br/>
                        <group>
                            <field name="date"/>
                            <field name="company_pct_report_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="provider_id"/>
                            <field name="seller_id"/>
                            <field name="service_1"/>
                            <field name="service_2"/>
                        </group>

                        <br/>
                        <group>
                            <field name="invoiced"/>
                            <field name="financial_cost"/>
                            <field name="amount_distributed"/>
                            <field name="to_pct"/>
                            <field name="to_pyxel"/>
                        </group>
                        <br/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pyxel_pct_tree" model="ir.ui.view">
            <field name="name">pyxel.pct.tree</field>
            <field name="model">pyxel.pct.report</field>
            <field name="arch" type="xml">
             <tree string="Lista de Reportet Pyxel-PCT">
                    <field name="provider_id"/>
                    <field name="seller_id"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>

        <record id="pyxel_pct_act_window" model="ir.actions.act_window">
            <field name="name">Pyxel-PCT</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pyxel.pct.report</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No existen reportes (Pyxel-PCT)
                </p>
            </field>
        </record>

        <!-- <menuitem name="Reporte Pyxel-PCT" id="pyxel_pct_menu" parent="cem_reports_root_menu"
                  action="pyxel_pct_act_window"/> -->
    </data>
</odoo>