<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_cem_import_int_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit.pyxel.cem.import.integration</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='selected_payment_method_payment_id']" position="before">
                    <field name="so_cem_order_type" invisible="1"/>

                </xpath>
                <xpath expr="//field[@name='selected_payment_method_payment_id']" position="attributes">
                    <attribute name="required">so_cem_order_type=='shop'</attribute>
                    <attribute name="invisible">so_cem_order_type!='shop'</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>