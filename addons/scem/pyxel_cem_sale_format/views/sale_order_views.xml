<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rolldey_website_sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="pyxel_cem_sale.sale_order_view_form_inherit" />
        <field name="arch" type="xml">

            <xpath expr="//page[@name='order_lines']//tree[1]//field[@name='product_uom_qty']"
                position="after">
                <field name="website_packaging_qty"></field>
            </xpath>

        </field>
    </record>

</odoo>