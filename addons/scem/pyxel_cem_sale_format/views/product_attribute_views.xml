<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="product_attribute_view_form_cem" model="ir.ui.view">
        <field name="name">product.attribute.form.inherit.cem</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="website_sale_comparison.product_attribute_view_form"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <field name="category_id"  position="after">
                <field name="is_packaging_attribute"/>
            </field>
        </field>
    </record>

    <record id="attribute_tree_view_cem" model="ir.ui.view">
        <field name="name">product.attribute.tree.cem</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.attribute_tree_view"/>
        <field name="arch" type="xml">
            <field name="create_variant" position="after">
                <field name="is_packaging_attribute"/>
            </field>
     
        </field>
    </record>
</odoo>