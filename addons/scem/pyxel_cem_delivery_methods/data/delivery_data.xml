    <record id="mk_flash_delivery" model="product.product">
        <field name="name">Envío Flash</field>
        <field name="default_code">Flash_Delivery</field>
        <field name="type">service</field>
        <field name="categ_id" ref="delivery.product_category_deliveries"/>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0.0</field>
        <field name="invoice_policy">order</field>
    </record>

    <!-- Delivery Methods -->
    <record id="free_dyeliver_carrier" model="delivery.carrier">
        <field name="name">Entrega estándar</field>
        <field name="fixed_price">0.0</field>
        <field name="sequence">1</field>
        <field name="delivery_type">based_on_seller</field>
        <field name="product_id" ref="pyxel_cem_delivery_methods.mk_seller_delivery"/>
    </record>

