<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_seo_form" model="ir.ui.view">
        <field name="name">product.template.seo.form.extension</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="seo" string="SEO">
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"/>
                        Optimiza tu producto para los motores de búsqueda (Meta descripción: 50-160 caracteres)
                    </div>
                    <group>
                        <field name="seo_custom_title" placeholder="Título SEO (se recomiendan 50-60 caracteres)"/>
                        <field name="seo_meta_description" placeholder="Meta descripción (50-160 caracteres)"/>
                        <field name="seo_h1_text" placeholder="Texto de etiqueta H1"/>
                        <field name="seo_focus_keyword" placeholder="Palabra clave de enfoque"/>
                        <field name="seo_canonical_url" placeholder="URL canónica"/>
                    </group>
                    <group string="Vista previa de SEO" invisible="1">
                        <!-- Esta sección se manejará con JavaScript en el widget -->
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>