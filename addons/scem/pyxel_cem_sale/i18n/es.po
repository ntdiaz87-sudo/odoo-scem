#. module: pyxel_cem_sale
#: model:mail.template,body_html:pyxel_cem_sale.mail_template_sale_canceled
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Dear\n"
"                        <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>.\n"
"                        <br>\n"
"                        <br>\n"
"                        Your order\n"
"                        <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">SUB003</span>\n"
"                        amounting in\n"
"                        <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 143,750.00\n"
"                        </span>\n"
"                        from <t t-out=\"object.company_id.name or ''\">YourCompany</t> has been canceled.\n"
"                        <br>\n"
"                        The invoice has been canceled too.\n"
"\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Estimado/a\n"
"                        <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>.\n"
"                        <br>\n"
"                        <br>\n"
"                        Su order\n"
"                        <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">SUB003</span>\n"
"                        con monto de \n"
"                        <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 143,750.00\n"
"                        </span>\n"
"                        de <t t-out=\"object.company_id.name or ''\">YourCompany</t> ha sido cancelado.\n"
"                        <br>\n"
"                        La factura fue cancelada igualmente.\n"
"                    </p>\n"
"                </div>\n"
"            "

