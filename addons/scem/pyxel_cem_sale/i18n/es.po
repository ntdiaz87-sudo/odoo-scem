#. module: pyxel_cem_sale
#: model:mail.template,body_html:pyxel_cem_sale.mail_template_sale_confirmation_custom
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>.\n"
"                        <br>\n"
"                        <br>\n"
"                        Your order <span style=\"font-weight:bold;\" t-out=\"object.name or ''\"></span> has been confirmed.\n"
"                        <br>\n"
"                        Thank you for your trust!\n"
"                        <br>\n"
"                        <br>\n"
"                        <t t-if=\"object.payment_meth_id.name\">\n"
"                            Do payment by: <span style=\"font-weight:bold;\" t-out=\"object.payment_meth_id.name or ''\"></span>\n"
"                        </t>\n"
"                        <br>\n"
"                        <br>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 12px;\">\n"
"                        Saludos <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>.\n"
"                        <br>\n"
"                        <br>\n"
"                        Su pedido <span style=\"font-weight:bold;\" t-out=\"object.name or ''\"></span> ha sido confirmado.\n"
"                        <br>\n"
"                        Agradecemos su confianza.\n"
"                        <br>\n"
"                        <br>\n"
"                        <t t-if=\"object.payment_meth_id.name\">"
"                           Realice el pago por: <span style=\"font-weight:bold;\" t-out=\"object.payment_meth_id.name or ''\"></span>\n"
"                        </t>"
"                        <br>\n"
"                        <br>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: pyxel_cem_sale
#: model:mail.template,body_html:pyxel_cem_sale.email_template_invoice_confirmation
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Estimado comercial,\n"
"                        <br><br>\n"
"                        La factura <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/0001</span> ha sido confirmada.\n"
"                        <br><br>\n"
"                        <strong>Cliente:</strong> <t t-out=\"object.partner_id.name or ''\">Cliente</t><br>\n"
"                        <strong>Total:</strong> <t t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$1,000.00</t><br>\n"
"                        <strong>Fecha:</strong> <t t-out=\"object.invoice_date or ''\">2024-01-01</t><br><br>\n"
"                        Saludos cordiales,<br>\n"
"                        <t t-out=\"object.company_id.name or ''\">Tu Empresa</t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: pyxel_cem_sale
#: model:mail.template,body_html:pyxel_cem_sale.mail_template_invoice_confirmation_custom
msgid ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear\n"
"                    <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>.\n"
"                    <br>\n"
"                    <br>\n"
"                    Here is your invoice\n"
"                    <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                    <t t-if=\"object.invoice_origin\">\n"
"                        (with reference: <span style=\"font-weight:bold;\" t-out=\"object.invoice_origin or ''\">SUB003</span>)\n"
"                    </t>\n"
"                    amounting in\n"
"                    <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 143,750.00\n"
"                    </span>\n"
"                    from <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"                    <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"                        This invoice is already paid.\n"
"                    </t>\n"
"\n"
"                </p>\n"
"            "
msgstr ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Estimado/a\n"
"                    <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>.\n"
"                    <br>\n"
"                    <br>\n"
"                    Aquí está su factura\n"
"                    <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"                    <t t-if=\"object.invoice_origin\">\n"
"                        (pedido: <span style=\"font-weight:bold;\" t-out=\"object.invoice_origin or ''\">SUB003</span>)\n"
"                    </t>\n"
"                    con monto de\n"
"                    <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 143,750.00\n"
"                    </span>\n"
"                    desde <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"                    <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"                        Esta factura ya está pagada.\n"
"                    </t>\n"
"\n"
"                </p>\n"
"            "

#. module: pyxel_cem_sale
#: model:mail.template,body_html:pyxel_cem_sale.mail_template_delivery_confirmation_custom
msgid ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>, the transfer\n"
"                    <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/OUT</span>\n"
"                    <t t-if=\"object.sale_id\">\n"
"                        with origin sale order: <t t-out=\"object.sale_id.name or ''\">SUB003</t>)\n"
"                    </t>\n"
"                    amounting in\n"
"                    <span style=\"font-weight:bold;\" t-out=\"format_amount(object.sale_id.amount_total, object.sale_id.currency_id) or ''\">$ 143,750.00\n"
"                    </span>\n"
"                    is ready to delivery\n"
"                    from <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"                    The invoice\n"
"                    <t t-set=\"invoice\" t-value=\"object.env.context.get('invoice_origin_name')\"></t>\n"
"                    <t t-if=\"invoice\">\n"
"                        <span style=\"font-weight:bold;\" t-out=\"invoice\"></span>\n"
"                    </t>\n"
"                    is already paid.\n"
"                </p>\n"
"            "
msgstr ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Estimado/a <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>, la entrega\n"
"                    <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/OUT</span>\n"
"                    <t t-if=\"object.sale_id\">\n"
"                        asociada al pedido: <t t-out=\"object.sale_id.name or ''\">SUB003</t>)\n"
"                    </t>\n"
"                    con monto de \n"
"                    <span style=\"font-weight:bold;\" t-out=\"format_amount(object.sale_id.amount_total, object.sale_id.currency_id) or ''\">$ 143,750.00\n"
"                    </span>\n"
"                    está lista para realizarse\n"
"                    desde <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"                    La factura\n"
"                    <t t-set=\"invoice\" t-value=\"object.env.context.get('invoice_origin_name')\"></t>\n"
"                    <t t-if=\"invoice\">\n"
"                        <span style=\"font-weight:bold;\" t-out=\"invoice\"></span>\n"
"                    </t>\n"
"                    está pagada.\n"
"                </p>\n"
"            "

