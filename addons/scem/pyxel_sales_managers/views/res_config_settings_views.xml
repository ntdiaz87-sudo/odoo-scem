<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_sales_manager" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.sales.manager</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pricing_setting_container']" position="after">
                    <block title="Gestores de Ventas" id="sales_managers_setting_container">
                        <setting id="enable_sales_managers_setting"
                                 help="Habilitar la gestión de gestores de ventas en el sistema">
                            <field name="enable_sales_managers"/>
                            <div class="content-group mt16" invisible="not enable_sales_managers">
                                <div class="text-muted">
                                    Cuando esté habilitado, podrás asignar gestores de ventas a clientes, órdenes de venta y facturas.
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

    </data>
</odoo>