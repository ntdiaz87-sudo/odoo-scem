<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Categoría de Módulo -->
        <record id="module_category_sales_managers" model="ir.module.category">
            <field name="name">Gestores de Ventas</field>
            <field name="description">Permisos para gestión de gestores de ventas</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupo: Usuario -->
        <record id="group_sales_manager_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_sales_managers"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo: Gestor -->
        <record id="group_sales_manager_manager" model="res.groups">
            <field name="name">Gestor</field>
            <field name="category_id" ref="module_category_sales_managers"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_manager_user'))]"/>
        </record>

        <!-- Grupo: Administrador -->
        <record id="group_sales_manager_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_category_sales_managers"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_manager_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Reglas de Acceso por Registro -->
        
        <!-- Regla: Usuario - Ver todos -->
        <record id="sales_manager_rule_user_read" model="ir.rule">
            <field name="name">Gestor de Ventas: Usuario - Lectura</field>
            <field name="model_id" ref="model_pyxel_sales_manager"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Gestor - Ver y editar todos -->
        <record id="sales_manager_rule_manager" model="ir.rule">
            <field name="name">Gestor de Ventas: Gestor - Escritura</field>
            <field name="model_id" ref="model_pyxel_sales_manager"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Administrador - Acceso completo -->
        <record id="sales_manager_rule_admin" model="ir.rule">
            <field name="name">Gestor de Ventas: Administrador - Completo</field>
            <field name="model_id" ref="model_pyxel_sales_manager"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Reglas multi-compañía -->
        <record id="sales_manager_company_rule" model="ir.rule">
            <field name="name">Gestor de Ventas: Multi-Compañía</field>
            <field name="model_id" ref="model_pyxel_sales_manager"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
