# Copia este fichero a .env en la raíz del clon del servidor (/opt/fabrica/.env),
# chmod 600, y genera los secretos con:  openssl rand -base64 32
# Los secretos de prod y dev deben ser DISTINTOS. Nunca comitear el .env real.

STACK=fabrica
FACTORY_HOST=fabrica.enetradex.com

# Puertos en 127.0.0.1 (ver deploy/README.md; comprobar que siguen libres)
WEB_PORT=8250
VENDURE_PORT=8251

DB_PASSWORD=CAMBIAR-openssl-rand
SUPERADMIN_PASSWORD=CAMBIAR-openssl-rand
COOKIE_SECRET=CAMBIAR-openssl-rand
